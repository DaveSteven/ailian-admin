{
  "name": "ailian-miniapp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "npm run build && node dist/scripts/migrate.js",
    "db:stats": "npm run build && node dist/scripts/db-stats.js",
    "import:excel": "npm run build && node dist/scripts/import-excel.js",
    "staff:add": "npm run build && node dist/scripts/add-staff.js"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.1",
    "ali-oss": "^6.23.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^4.28.1",
    "pg": "^8.21.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.20.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
